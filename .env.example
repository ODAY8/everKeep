# Copy this file to `.env` (which is git-ignored) and fill in your own values:
#
#   cp .env.example .env
#   run.cmd                                   (Windows helper), or
#   flutter run --dart-define-from-file=.env
#
# These are compiled into the app, so they are needed on every run and every
# build (hot reload and an already-installed build won't pick up a change).
#
# ─── Required ────────────────────────────────────────────────────────────────
# Find both in the Supabase dashboard: Project Settings -> API Keys.
#
# ONLY the project URL and the PUBLISHABLE key go here. The publishable key is
# meant to be embedded in client apps; Row Level Security is what protects the
# data. NEVER put a secret key, service-role key, or database password in this
# file or anywhere else in the Flutter app.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=xxxxx

# ─── Optional: help & legal links ────────────────────────────────────────────
# Anything left empty is simply not shown in the app (Settings -> Support/Legal),
# so there are never buttons that go nowhere. Fill in the ones you really have.
# SUPPORT_EMAIL=help@yourdomain.com
# HELP_URL=https://yourdomain.com/help
# TERMS_URL=https://yourdomain.com/terms
# PRIVACY_URL=https://yourdomain.com/privacy

# ─── Optional: email-link redirect ───────────────────────────────────────────
# Where "confirm your email" and "reset your password" links send people back to.
# The default is com.example.everkeep://login-callback/. Only set this if you
# change the app's package id (and then change the intent filter in
# android/app/src/main/AndroidManifest.xml and the URL scheme in
# ios/Runner/Info.plist to match). Whatever it is, the same value must be added
# in Supabase: Authentication -> URL Configuration -> Redirect URLs.
# AUTH_REDIRECT_URL=com.example.everkeep://login-callback/
