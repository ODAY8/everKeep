<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen: the app's own near-black background (AppColors.glassBackground)
     so there is no white flash before the first frame is drawn. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF111113" />
        </shape>
    </item>
</layer-list>
